FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including Poetry
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
ENV POETRY_VERSION=1.7.1
ENV PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
ENV POETRY_VIRTUALENVS_IN_PROJECT=false
ENV POETRY_VIRTUALENVS_CREATE=true
ENV POETRY_VIRTUALENVS_PATH=/opt/poetry-venvs
RUN pip install --no-cache-dir --upgrade pip setuptools \
 && pip install --no-cache-dir "poetry==$POETRY_VERSION"

# Copy dependency files
COPY pyproject.toml poetry.lock* ./

# Install dependencies for agent service only
RUN poetry install --no-interaction --no-ansi --no-root --only main --extras agent

RUN ln -s "$(poetry env info --path)" /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/notes

CMD ["python", "-m", "KestrelAI.model_loop"]
